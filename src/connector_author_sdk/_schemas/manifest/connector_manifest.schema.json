{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbixal.dev/schemas/manifest/connector_manifest.schema.json",
  "title": "ConnectorManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "key",
    "name",
    "version",
    "manifest_schema_version",
    "sdk_version",
    "runtime_compatibility_range",
    "capabilities",
    "auth_schema",
    "egress_policy",
    "config_schema",
    "resource_types",
    "operations"
  ],
  "properties": {
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "manifest_schema_version": {
      "type": "string",
      "minLength": 1
    },
    "sdk_version": {
      "type": "string",
      "minLength": 1
    },
    "runtime_compatibility_range": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "auth_schema": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["none", "api_key", "oauth2", "basic_auth", "service_account", "custom_headers"]
        },
        "required_fields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "optional_fields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "egress_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "mode",
        "enforcement",
        "default_action",
        "allowed_hosts",
        "allowed_methods",
        "allowed_ports"
      ],
      "properties": {
        "version": { "const": "1" },
        "mode": { "type": "string", "enum": ["none", "provider_proxy"] },
        "enforcement": { "const": "egress_proxy" },
        "default_action": { "const": "deny" },
        "allowed_hosts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
          },
          "uniqueItems": true
        },
        "allowed_methods": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["DELETE", "GET", "HEAD", "OPTIONS", "PATCH", "POST", "PUT"]
          },
          "uniqueItems": true
        },
        "allowed_ports": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "uniqueItems": true
        },
        "allowed_path_prefixes": {
          "type": "array",
          "items": { "type": "string", "pattern": "^/" },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "none" } }, "required": ["mode"] },
          "then": {
            "properties": {
              "allowed_hosts": { "maxItems": 0 },
              "allowed_methods": { "maxItems": 0 },
              "allowed_ports": { "maxItems": 0 },
              "allowed_path_prefixes": { "maxItems": 0 }
            }
          }
        },
        {
          "if": { "properties": { "mode": { "const": "provider_proxy" } }, "required": ["mode"] },
          "then": {
            "properties": {
              "allowed_hosts": { "minItems": 1 },
              "allowed_methods": { "minItems": 1 },
              "allowed_ports": { "minItems": 1 }
            }
          }
        }
      ]
    },
    "entitlement": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["provider", "requires_byok", "storage_policy", "exposure_policy"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "requires_byok": { "type": "boolean" },
        "storage_policy": { "type": "string", "minLength": 1 },
        "exposure_policy": { "type": "string", "minLength": 1 },
        "audit_policy": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      }
    },
    "config_schema": {
      "type": "object",
      "not": {
        "required": ["additionalProperties"]
      }
    },
    "resource_types": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "input_schema"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": ["read", "query"]
          },
          "input_schema": {
            "type": "object"
          },
          "output_schema": {
            "type": "object"
          }
        }
      }
    }
  }
}
